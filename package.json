{
  "name": "happy-soils-maps",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently -k -n api,web -c green,cyan \"pnpm dev:api\" \"pnpm dev\"",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "build:api": "tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm test && pnpm build && pnpm build:api"
  },
  "dependencies": {
    "@turf/area": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.2.108",
    "proj4": "^2.21.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
