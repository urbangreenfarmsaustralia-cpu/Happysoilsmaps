# SILO requires the caller's contact email on every data request.
SILO_API_USERNAME=service-account@example.com

# Address searches use a click-triggered OpenStreetMap Nominatim lookup by default.
# Set these to identify the deployed service or switch to a compatible managed/self-hosted endpoint.
GEOCODER_USER_AGENT=HappySoilsMaps/0.2 (https://your-public-site.example)
# GEOCODER_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Required outside local development for full adviser responses and outcome records.
ADVISER_API_TOKEN=replace-with-a-long-random-token

# Optional overrides.
HAPPY_SOILS_API_PORT=8787
HAPPY_SOILS_DATA_DIR=.local-data
